def calculate_angle(a, b, c):
    """Угол в точке b между векторами ba и bc. Возвращает градусы."""
    ba = np.array(a) - np.array(b)
    bc = np.array(c) - np.array(b)
    n1, n2 = np.linalg.norm(ba), np.linalg.norm(bc)
    if n1 * n2 < 1e-8:
        return 0.0
    return np.degrees(np.arccos(np.clip(np.dot(ba, bc) / (n1 * n2), -1.0, 1.0)))

def get_coords(lm):
    """
    Возвращает координаты ключевых точек.
    Используем x, y, z — MediaPipe даёт все три оси.
    z — относительная глубина (ненадёжна как самостоятельный признак,
    но используется внутри calculate_angle для 3D-угла позвоночника).
    """
    idx_map = {
        'nose': 0,
        'left_ear': 7, 'right_ear': 8,          # ← нужны для spine_angle
        'left_shoulder': 11, 'right_shoulder': 12,
        'left_elbow': 13, 'right_elbow': 14,
        'left_wrist': 15, 'right_wrist': 16,
        'left_hip': 23, 'right_hip': 24,
        'left_knee': 25, 'right_knee': 26,
        'left_ankle': 27, 'right_ankle': 28,
        'left_heel': 29, 'right_heel': 30,
        'left_foot_index': 31, 'right_foot_index': 32,
    }
    coords = {}
    for name, idx in idx_map.items():
        if idx < len(lm):
            # Храним все три координаты — нужны для 3D угла позвоночника
            coords[name] = np.array([lm[idx].x, lm[idx].y, lm[idx].z])
        else:
            coords[name] = np.array([np.nan, np.nan, np.nan])
    return coords

def normalize(coords):
    """
    Нормализация относительно центра таза и масштаба торса.
    Работает только с x, y — для инвариантности к дистанции от камеры.
    """
    l_hip, r_hip = coords['left_hip'][:2], coords['right_hip'][:2]
    center = (l_hip + r_hip) / 2
    l_sh, r_sh = coords['left_shoulder'][:2], coords['right_shoulder'][:2]
    scale = np.linalg.norm((l_sh + r_sh) / 2 - center) + 1e-6

    def n(key):
        return (coords[key][:2] - center) / scale

    return n, scale

def extract_features_for_model(lm, prev=None):
    """Признаки для ML-классификатора упражнений. Не трогаем — модель обучена на них."""
    f = {}
    c = get_coords(lm)
    if any(np.isnan(c[k]).any() for k in ['nose', 'left_hip', 'right_hip']):
        return None
    n, _ = normalize(c)

    mid_sh  = (n('left_shoulder') + n('right_shoulder')) / 2
    mid_hip = (n('left_hip')      + n('right_hip'))      / 2
    nose    = n('nose')

    f['left_elbow_angle']     = calculate_angle(n('left_shoulder'),  n('left_elbow'),  n('left_wrist'))
    f['right_elbow_angle']    = calculate_angle(n('right_shoulder'), n('right_elbow'), n('right_wrist'))
    f['left_shoulder_angle']  = calculate_angle(n('left_elbow'),     n('left_shoulder'),  n('left_hip'))
    f['right_shoulder_angle'] = calculate_angle(n('right_elbow'),    n('right_shoulder'), n('right_hip'))
    f['left_knee_angle']      = calculate_angle(n('left_hip'),  n('left_knee'),  n('left_ankle'))
    f['right_knee_angle']     = calculate_angle(n('right_hip'), n('right_knee'), n('right_ankle'))
    f['left_hip_angle']       = calculate_angle(n('left_shoulder'),  n('left_hip'),  n('left_knee'))
    f['right_hip_angle']      = calculate_angle(n('right_shoulder'), n('right_hip'), n('right_knee'))
    f['left_ankle_angle']     = calculate_angle(n('left_knee'),  n('left_ankle'),  n('left_foot_index'))
    f['right_ankle_angle']    = calculate_angle(n('right_knee'), n('right_ankle'), n('right_foot_index'))

    f['trunk_lean']  = np.degrees(np.arctan2(abs(mid_sh[0]-mid_hip[0]), abs(mid_sh[1]-mid_hip[1])+1e-6))
    f['head_tilt']   = np.degrees(np.arctan2(abs(nose[0]-mid_sh[0]),    abs(nose[1]-mid_sh[1])+1e-6))
    f['body_verticality']  = abs(mid_sh[1] - mid_hip[1])
    f['body_horizontal']   = abs(mid_sh[0] - mid_hip[0])
    f['orientation_ratio'] = f['body_verticality'] / (f['body_horizontal'] + 1e-6)

    model_landmarks = [
        'nose', 'left_shoulder', 'right_shoulder', 'left_elbow', 'right_elbow',
        'left_wrist', 'right_wrist', 'left_hip', 'right_hip', 'left_knee',
        'right_knee', 'left_ankle', 'right_ankle', 'left_foot_index', 'right_foot_index',
    ]
    all_pts = [n(k) for k in model_landmarks if k in c and not np.isnan(c[k]).any()]
    all_y   = [p[1] for p in all_pts]
    all_x   = [p[0] for p in all_pts]
    f['bbox_aspect'] = (max(all_y)-min(all_y)+1e-6) / (max(all_x)-min(all_x)+1e-6)

    f['knee_symmetry']     = abs(f['left_knee_angle']     - f['right_knee_angle'])
    f['elbow_symmetry']    = abs(f['left_elbow_angle']    - f['right_elbow_angle'])
    f['shoulder_symmetry'] = abs(f['left_shoulder_angle'] - f['right_shoulder_angle'])
    f['hip_symmetry']      = abs(f['left_hip_angle']      - f['right_hip_angle'])
    f['feet_width']             = np.linalg.norm(n('left_ankle') - n('right_ankle'))
    f['shoulder_width']         = np.linalg.norm(n('left_shoulder') - n('right_shoulder'))
    f['feet_to_shoulder_ratio'] = f['feet_width'] / (f['shoulder_width'] + 1e-6)
    f['hip_height']    = mid_hip[1] - mid_sh[1]
    f['height_ratio']  = np.linalg.norm(mid_sh - mid_hip) / (f['shoulder_width'] + 1e-6)

    vel_cols = ['left_elbow_angle','right_elbow_angle','left_shoulder_angle','right_shoulder_angle',
                'left_knee_angle','right_knee_angle','left_hip_angle','right_hip_angle',
                'trunk_lean','hip_height']
    for col in vel_cols:
        f[f'vel_{col}'] = (f[col] - prev[col]) if prev and col in prev else 0.0

    return f


def _knee_valgus(n_func, side):
    """
    Перпендикулярное смещение колена от линии бедро→лодыжка.
    Положительное = колено ушло вовнутрь (valgus).
    Отрицательное = наружу (varus).
    Работает при ФРОНТАЛЬНОЙ съёмке — там X-смещение максимально.
    """
    hip   = n_func(f'{side}_hip')
    knee  = n_func(f'{side}_knee')
    ankle = n_func(f'{side}_ankle')
    limb_vec  = ankle - hip
    limb_unit = limb_vec / (np.linalg.norm(limb_vec) + 1e-6)
    knee_vec  = knee - hip
    proj      = np.dot(knee_vec, limb_unit)
    perp      = knee_vec - proj * limb_unit
    return perp[0] if side == 'left' else -perp[0]


def _knee_width_ratio(n_func):
    """
    Ширина коленей / ширина лодыжек.
    ~1.0 = норма, >1.0 = широко, <1.0 = узко.
    Инвариантен к масштабу — это отношение.
    """
    knee_w  = abs(n_func('left_knee')[0]  - n_func('right_knee')[0])
    ankle_w = abs(n_func('left_ankle')[0] - n_func('right_ankle')[0])
    return knee_w / (ankle_w + 1e-6)


def _rounded_back(n_func):
    """
    mid_shoulder_y - nose_y (в MediaPipe Y растёт вниз).
    Прямая спина: нос выше плеч → значение > 0.
    Горб: нос опускается до уровня плеч → значение уменьшается / становится < 0.
    Работает фронтально, сзади и при диагональной съёмке.
    """
    nose   = n_func('nose')
    mid_sh = (n_func('left_shoulder') + n_func('right_shoulder')) / 2
    return mid_sh[1] - nose[1]


def _spine_flexion(n_func):
    """
    Угол наклона корпуса от вертикали.
    0° = идеально вертикально, растёт при наклоне вперёд/назад.
    Лучше всего при БОКОВОЙ съёмке.
    """
    mid_sh  = (n_func('left_shoulder') + n_func('right_shoulder')) / 2
    mid_hip = (n_func('left_hip')      + n_func('right_hip'))      / 2
    return np.degrees(np.arctan2(
        abs(mid_sh[0] - mid_hip[0]),
        abs(mid_sh[1] - mid_hip[1]) + 1e-6
    ))


def _lumbar_extension(n_func):
    """
    mid_hip_x - mid_shoulder_x.
    Норма ≈ 0.
    Бёдра вперёд (прогиб поясницы) → положительное.
    Откидывание назад → отрицательное.
    abs() в detect_errors ловит оба случая.
    """
    mid_sh  = (n_func('left_shoulder') + n_func('right_shoulder')) / 2
    mid_hip = (n_func('left_hip')      + n_func('right_hip'))      / 2
    return mid_hip[0] - mid_sh[0]


def extract_features_for_analysis(lm):          # signature unchanged
    """Thin wrapper around the shared analysis extractor used in tests."""
    return shared_extract_features_for_analysis(lm, get_coords, normalize)

def predict_exercise(feat_dict):
    col_order = scaler.feature_names_in_ if hasattr(scaler, 'feature_names_in_') else feature_order
    X = pd.DataFrame([{k: feat_dict.get(k, 0.0) for k in col_order}])
    X_sc = scaler.transform(X)
    pred  = model.predict(X_sc)[0]
    proba = model.predict_proba(X_sc)[0]
    return le.inverse_transform([pred])[0], float(proba[pred])



def generate_report(session_error_counts: dict, total_frames: int, duration_sec: float) -> str:
    lines = []
    now = datetime.now().strftime('%Y-%m-%d %H:%M:%S')

    lines.append('=' * 60)
    lines.append('      АНАЛИЗ ТЕХНИКИ ПРИСЕДАНИЙ')
    lines.append('=' * 60)
    lines.append(f'Дата          : {now}')
    lines.append(f'Продолжит.    : {duration_sec:.1f} сек')
    lines.append(f'Кадров        : {total_frames}')
    lines.append('')

    significant = {
        err: cnt for err, cnt in session_error_counts.items()
        if total_frames > 0 and (cnt / total_frames) >= 0.05
    }

    if not significant:
        lines.append('РЕЗУЛЬТАТ: Значимых ошибок не обнаружено.')
        lines.append('')
        lines.append('Техника приседаний выглядит хорошо. Продолжайте в том же духе!')
        lines.append('Сохраняйте это качество при увеличении веса или количества повторений.')
    else:
        sorted_errors = sorted(significant.items(), key=lambda x: x[1], reverse=True)
        freq_list = [(err, cnt / total_frames * 100) for err, cnt in sorted_errors]

        lines.append(f'РЕЗУЛЬТАТ: обнаружено нарушений — {len(significant)}.')
        lines.append('')
        lines.append('СВОДКА')
        lines.append('-' * 40)
        for err, pct in freq_list:
            bar = '█' * int(pct / 5)
            lines.append(f'  {err:<28} {pct:5.1f}%  {bar}')
        lines.append('')

        lines.append('ПОДРОБНЫЙ РАЗБОР')
        lines.append('-' * 40)
        for i, (err, pct) in enumerate(freq_list, 1):
            short_desc, advice = ERROR_DESCRIPTIONS.get(err, (err, 'Дополнительных рекомендаций нет.'))
            lines.append(f'{i}. {err}  ({pct:.1f}% of frames)')
            lines.append(f'   Что произошло : {short_desc}')
            lines.append(f'   Как исправить : {advice}')
            lines.append('')

        lines.append('ПРИОРИТЕТ')
        lines.append('-' * 40)
        top_err, top_pct = freq_list[0]
        short_desc, advice = ERROR_DESCRIPTIONS.get(top_err, (top_err, ''))
        lines.append(f'Сосредоточьтесь сначала на "{top_err}" — встречалось в {top_pct:.1f}% кадров.')
        lines.append(f'{advice}')

    lines.append('')
    lines.append('=' * 60)
    return '\n'.join(lines)

def save_report(report_text: str) -> str:
    os.makedirs('Reports', exist_ok=True)
    filename = f'Reports/squat_report_{datetime.now().strftime("%Y%m%d_%H%M%S")}.txt'
    with open(filename, 'w', encoding='utf-8') as f:
        f.write(report_text)
    return filename

